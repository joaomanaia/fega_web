{
  "name": "fegaweb",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run fegaweb#dev",
    "build": "turbo run build",
    "build:web": "turbo run fegaweb#build",
    "typecheck": "turbo run typecheck",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
